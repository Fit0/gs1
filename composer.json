{
    "name": "fit0/gs1",
    "description": "GS1 for PHP: GTIN and SSCC check digits, a GS1-128 element string parser and ZPL and PDF label rendering, with a Laravel bridge.",
    "type": "library",
    "license": "MIT",
    "keywords": ["gs1", "gtin", "sscc", "gs1-128", "barcode", "label", "zpl", "laravel"],
    "homepage": "https://github.com/Fit0/gs1",
    "authors": [
        {
            "name": "Alfonso Ríos Pérez"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.1",
        "rector/rector": "^2.7"
    },
    "suggest": {
        "laravel/framework": "Needed for the Laravel bridge (^12.0 or ^13.0)"
    },
    "autoload": {
        "psr-4": {
            "Fit0\\Gs1\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fit0\\Gs1\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fit0\\Gs1\\Laravel\\Gs1ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
